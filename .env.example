# ============================================================================
# Pinora — environment template
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# NEVER commit `.env`. It is ignored by .gitignore.
# ============================================================================

# ---------------------------------------------------------------------------
# Turso (libSQL) database — REQUIRED for the real, persistent database
# ---------------------------------------------------------------------------
# Create a database with the Turso CLI:
#   turso db create pinora
#   turso db show pinora --url          -> paste into TURSO_DATABASE_URL
#   turso db tokens create pinora       -> paste into TURSO_AUTH_TOKEN
#
# The token is read on the server only and is never sent to the browser.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Database driver selection
# ---------------------------------------------------------------------------
# auto  : use Turso when TURSO_DATABASE_URL is set, otherwise the local file
# turso : force Turso (fails loudly when unreachable)
# local : force the local libSQL file (offline development / evaluation)
DB_DRIVER=auto

# Set to 1 to disable the automatic fallback to the local file when Turso is
# configured but unreachable. Recommended for production.
# DB_STRICT=1

# Set to 1 to run migrations + seed automatically when the server boots against
# an empty database. Enabled for you on Vercel (see server/env.js).
# DB_BOOTSTRAP=1

# Local libSQL/SQLite file used when DB_DRIVER=local (or as a fallback).
LOCAL_DB_FILE=data/local.db

# ---------------------------------------------------------------------------
# Image uploads
# ---------------------------------------------------------------------------
# Uploaded images live on disk (NOT inside Turso); only their URL is stored in
# the database. Point UPLOAD_DIR at a persistent volume in production.
UPLOAD_DIR=data/uploads

# Maximum upload size is 8 MB (4 MB on Vercel, whose edge rejects request
# bodies above 4.5 MB before they reach the server).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Public base URL of the deployment (used for share links).
APP_URL=http://localhost:3000
